    <!-- Looper onboarding -->
    <string name="looper_onboarding_title">Before you start</string>
    <string name="looper_onboarding_scroll_hint">↓ Scroll to the end to continue</string>
    <string name="looper_onboarding_confirm_ready">Got it, let\'s go!</string>
    <string name="looper_onboarding_confirm_read">Read to the end</string>
    <string name="looper_onboarding_scroll_done">— Scroll up to re-read —</string>
    <string name="looper_onboarding_1_title">Maximum silence</string>
    <string name="looper_onboarding_1_text">During recording, make sure there are no background noises — fan hum, conversations, street noise will get into the track and be audible during playback. Close the windows, turn off devices.</string>
    <string name="looper_onboarding_2_title">Use headphones</string>
    <string name="looper_onboarding_2_text">Recording without headphones lets speaker sound bleed into the microphone and creates an echo. Always record tracks with headphones on.</string>
    <string name="looper_onboarding_3_title">Equal track lengths</string>
    <string name="looper_onboarding_3_text">For correct synchronisation all tracks must be the same length. For example, if the first track is 4 bars, all others must also be exactly 4 bars. Use a metronome or count aloud to keep tempo.</string>
    <string name="looper_onboarding_4_title">Trim for precision</string>
    <string name="looper_onboarding_4_text">After recording, use the trim tool to align the exact start and end of the loop. Even a small offset of a few milliseconds will accumulate and throw off the rhythm.</string>
    <string name="looper_onboarding_5_title">Volume and balance</string>
    <string name="looper_onboarding_5_text">Record each instrument at roughly the same volume. If one track is much louder than the others — use the volume slider to balance after recording.</string>

